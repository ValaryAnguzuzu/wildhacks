# Firebase Web App config (Project settings → General → Your apps)
# Copy this file to `.env` and fill in values. Never commit `.env`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fin advisor (src/api/advisor.ts): if VITE_GROQ_API_KEY is set, Groq is used (free tier — get a key at https://console.groq.com )
VITE_GROQ_API_KEY=
# Optional Groq model (default llama-3.3-70b-versatile)
# VITE_GROQ_ADVISOR_MODEL=llama-3.1-8b-instant

# OpenAI — used for the advisor only when VITE_GROQ_API_KEY is empty; also optional FinSim (src/finsim/generateScenario.ts)
VITE_OPENAI_API_KEY=
# Optional: model for the advisor when using OpenAI (default gpt-4o-mini)
# VITE_OPENAI_ADVISOR_MODEL=gpt-4o
# Optional: override OpenAI API base URL (defaults to https://api.openai.com)
# VITE_OPENAI_URL=

