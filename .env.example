# Firebase Web App config (Project settings → General → Your apps)
# Copy this file to `.env` and fill in values. Never commit `.env`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: OpenAI API key for FinSim scenario text (see src/finsim/generateScenario.ts)
VITE_OPENAI_API_KEY=

# Anthropic (Claude) API key for in-app financial advisor — see src/api/advisor.ts
VITE_CLAUDE_API_KEY=
# Optional: override OpenAI API base URL (defaults to https://api.openai.com)
# VITE_OPENAI_URL=

